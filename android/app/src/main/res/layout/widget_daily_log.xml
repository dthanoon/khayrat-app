<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center_vertical">

  <!-- Header row -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="🌿 Khayrat"
        android:textColor="#10b981"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="#666666"
        android:textSize="10sp"/>
  </LinearLayout>

  <!-- Quran row -->
  <LinearLayout
      android:id="@+id/row_quran"
      android:layout_width="match_parent"
      android:layout_height="34dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:layout_marginBottom="6dp"
      android:background="@drawable/widget_row_unchecked">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="📖 Quran"
        android:textColor="#e5e5e5"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/check_quran"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○"
        android:textColor="#666666"
        android:textSize="14sp"/>
  </LinearLayout>

  <!-- Fasting row -->
  <LinearLayout
      android:id="@+id/row_fasting"
      android:layout_width="match_parent"
      android:layout_height="34dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:layout_marginBottom="6dp"
      android:background="@drawable/widget_row_unchecked">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="🌙 Fasting"
        android:textColor="#e5e5e5"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/check_fasting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○"
        android:textColor="#666666"
        android:textSize="14sp"/>
  </LinearLayout>

  <!-- Qiyam row -->
  <LinearLayout
      android:id="@+id/row_qiyam"
      android:layout_width="match_parent"
      android:layout_height="34dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:layout_marginBottom="6dp"
      android:background="@drawable/widget_row_unchecked">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="⭐ Qiyam"
        android:textColor="#e5e5e5"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/check_qiyam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○"
        android:textColor="#666666"
        android:textSize="14sp"/>
  </LinearLayout>

  <!-- Kahf row — only shown on Fridays, hidden otherwise -->
  <LinearLayout
      android:id="@+id/row_kahf"
      android:layout_width="match_parent"
      android:layout_height="34dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:visibility="gone"
      android:background="@drawable/widget_row_unchecked">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="📗 Kahf"
        android:textColor="#e5e5e5"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/check_kahf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○"
        android:textColor="#666666"
        android:textSize="14sp"/>
  </LinearLayout>

</LinearLayout>
