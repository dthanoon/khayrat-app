# Supabase — same project as the web app
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Web app API base URL (deployed on Render)
# Used for: /api/register (user creation with pre-confirmed email)
EXPO_PUBLIC_API_BASE_URL=https://your-app.onrender.com
